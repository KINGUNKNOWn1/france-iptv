{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/speedtest/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-transform"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.(jpg|jpeg|png|gif|svg|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.franceiptv.stream"
        }
      ],
      "destination": "https://franceiptv.stream/",
      "permanent": true
    },
    {
      "source": "/blog/liste-chaines-francaises-iptv",
      "destination": "/chaines",
      "permanent": true
    },
    {
      "source": "/blog/acheter-iptv-france-guide-complet",
      "destination": "/acheter-iptv",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/meilleures-applications-iptv-2024",
      "destination": "/blog/meilleures-applications-iptv",
      "permanent": true
    },
    {
      "source": "/blog/installer-iptv-samsung-tv",
      "destination": "/appareils/samsung-tv",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.franceiptv.stream"
        }
      ],
      "destination": "https://franceiptv.stream/:path*",
      "permanent": true
    }
  ]
}
